{
  "name": "2013-st-louis-knights",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "tsx scripts/validate.ts && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "tsx --test tests/*.test.ts",
    "import:standings": "tsx scripts/import.ts standings",
    "import:ratings": "tsx scripts/import.ts ratings",
    "import:schedule": "tsx scripts/import-schedule.ts",
    "validate": "tsx scripts/validate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import:crossbar": "tsx scripts/import-crossbar.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.1",
    "astro": "^7.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
