---
import Layout from '../layouts/Layout.astro';
import { sources, standings, status } from '../lib/data';
import { formatTimestamp, formatDate } from '../lib/history';
import { schedule, scheduleStatus, crossbar, crossbarStatus } from '../lib/schedule-data';
---

<Layout title="Sources and updates">
  <div class="page-heading">
    <div>
      <span class="eyebrow">TRANSPARENT BY DESIGN</span>
      <h1>Know where the numbers come from.</h1>
      <p>Source links, capture dates, and the current state of each update.</p>
    </div>
  </div>
  <div class="source-grid">
    <section class="panel explainer">
      <span class="eyebrow">GAME SCHEDULE</span>
      <h2>CSDHL / GameSheet</h2>
      <p>
        The native schedule contains {schedule.games.length} regular-season games across all 13 teams. Each
        game links back to its official GameSheet page.
      </p>
      <dl>
        <dt>Collected</dt>
        <dd>{formatTimestamp(schedule.collectedAt)}</dd>
        <dt>Source publication time</dt>
        <dd>Not supplied by source</dd>
        <dt>Update status</dt>
        <dd>{scheduleStatus.error ?? 'Verified browser snapshot; automated feed pending'}</dd>
      </dl>
      <p>
        The homepage advances to the next scheduled Knights game based on Central time. This does not fetch
        changes from GameSheet; a new snapshot is required to reflect rescheduling or cancellation.
      </p>
      <a href={schedule.sourceUrl}>Official division schedule ↗</a>
    </section>
    <section class="panel explainer">
      <span class="eyebrow">KNIGHTS ADDITIONAL GAMES</span>
      <h2>Crossbar team schedule</h2>
      <p>
        The Knights’ public Crossbar schedule is checked daily. Matching CSDHL games appear once with
        GameSheet details; additional games and tournament dates are included separately. Tournament
        placeholders do not become the homepage’s next game.
      </p>
      <dl>
        <dt>Last successful check</dt>
        <dd>{formatTimestamp(crossbarStatus.lastSuccessfulCheck!)}</dd>
        <dt>Source publication time</dt>
        <dd>Not supplied by source</dd>
        <dt>Update status</dt>
        <dd>{crossbarStatus.error ?? 'Daily refresh configured'}</dd>
      </dl>
      <a href={crossbar.sourceUrl}>Knights Crossbar schedule ↗</a>
    </section>
    <section class="panel explainer">
      <span class="eyebrow">LEAGUE STANDINGS</span>
      <h2>CSDHL / GameSheet</h2>
      <p>
        The league's 2026–27 page embeds GameSheet season 15220. This portal follows Bantam Minor, division
        81589, filtered to regular-season games.
      </p>
      <dl>
        <dt>Last observation</dt>
        <dd>{formatTimestamp(standings?.observedAt ?? null)}</dd>
        <dt>Source publication time</dt>
        <dd>
          {standings?.sourcePublishedAt
            ? formatTimestamp(standings.sourcePublishedAt)
            : 'Not supplied by source'}
        </dd>
        <dt>Last successful check</dt>
        <dd>{formatTimestamp(status.standings.lastSuccessAt)}</dd>
        <dt>Update status</dt>
        <dd>{status.standings.message}</dd>
      </dl>
      <p>
        The live official view remains available on the standings page. Automated snapshot refresh needs a
        supported feed; the displayed capture time does not imply continuous synchronization.
      </p>
      <a href={sources.leagueUrl}>Official league page ↗</a> ·{' '}
      <a href={sources.standings.sourceUrl}>GameSheet division ↗</a>
    </section>
    <section class="panel explainer">
      <span class="eyebrow">WEEKLY RATINGS</span>
      <h2>MyHockeyRankings</h2>
      <p>{sources.ratings.note}</p>
      <dl>
        <dt>Access</dt>
        <dd>{sources.ratings.access === 'approved' ? 'Approved data source' : 'Authorization pending'}</dd>
        <dt>Last successful check</dt>
        <dd>{formatTimestamp(status.ratings.lastSuccessAt)}</dd>
        <dt>Weekly publication schedule</dt>
        <dd>
          {sources.ratings.publicationScheduleVerified
            ? 'Verified for this season'
            : 'Wednesday is the usual cadence; 2026–27 timing awaits verification'}
        </dd>
      </dl>
      <p>
        No placeholder ratings or prior-season ratings appear as current results. Missing weeks will never be
        reconstructed from the latest rating.
      </p>
      <a href={sources.ratings.sourceUrl}>MHR division ↗</a> ·{' '}
      <a href="https://myhockeyrankings.com/terms.php">MHR terms ↗</a>
    </section>
  </div>
  <section class="panel explainer">
    <h2>Team directory & corrections</h2>
    <p>
      The 13-team membership was verified on {formatDate(sources.membershipVerifiedAt)}. Club websites were
      matched against the <a href="https://www.csdhl.org/about/members/39951">league member directory</a>.
      Season-specific MHR links point to the 2026–27 pages. The Knights crest comes from the{' '}
      <a href="https://www.stlknightshockey.com/">official club website</a>. Team logos shown beside names
      were matched to each team's official GameSheet listing. All logos remain the property of their
      respective clubs.
    </p>
    <p>
      Repeated imports do not add duplicate observations. Corrections are retained as new revisions, and
      charts display the latest revision for each release. If an update fails, the last valid data stays
      visible with its original observation time.
    </p>
  </section>
</Layout>
