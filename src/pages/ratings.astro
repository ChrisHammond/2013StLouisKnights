---
import Layout from '../layouts/Layout.astro';
import Ratings from '../components/Ratings.astro';
---

<Layout title="Weekly rating history">
  <div class="page-heading">
    <div>
      <span class="eyebrow">2026–27 · MYHOCKEYRANKINGS</span>
      <h1>Follow the progress.</h1>
      <p>Weekly numeric ratings for every team in the CSDHL 13U division.</p>
    </div>
  </div>
  <Ratings />
  <section class="panel explainer">
    <h2>Reading the weekly ratings</h2>
    <p>
      A rating is a numeric measure of a team's results. This chart follows each team's published rating
      over the season. The table shows its weekly value and change.
    </p>
    <p>
      Weekly changes compare consecutive releases seven days apart within the same category. Unrated teams and
      missed weeks remain empty. Earlier weeks will only appear if a verified historical source
      becomes available.
    </p>
    <a href="/sources/">How updates work →</a>
  </section>
</Layout>
