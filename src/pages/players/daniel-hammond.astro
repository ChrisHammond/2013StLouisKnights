---
import Layout from '../../layouts/Layout.astro';
import raw from '../../../data/players/daniel-hammond.json';
import { playerStatsSchema, statLabels, total, averageIceTime, displayStat } from '../../lib/player-stats';
const data = playerStatsSchema.parse(raw);
const games = data.games;
const dateLabel = (date: string) =>
  new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(date + 'T12:00:00Z'));
const signed = (v: number | null) => (v === null ? '—' : v > 0 ? `+${v}` : String(v));
const summary = [
  ['Games', games.length],
  ['Goals', total(games, 'Goals')],
  ['Assists', total(games, 'Assists')],
  ['Points', total(games, 'Points')],
  ['Plus / minus', signed(total(games, '+/-'))],
  ['Avg. ice time', averageIceTime(games)],
];
const importedOn = data.importedAt.slice(0, 10);
const shots = total(games, 'Shots'),
  onGoal = total(games, 'Shots on goal');
const shotRate =
  shots !== null && onGoal !== null && shots > 0 ? `${Math.round((onGoal / shots) * 100)}%` : '—';
---

<Layout
  title="Daniel Hammond · #11"
  description="Daniel Hammond’s St. Louis Knights player profile, imported Hudl Instat statistics, and game-by-game performance."
>
  <a class="back" href="/players/">
    ← Players
  </a>
  <header class="profile-hero">
    <div class="jersey" aria-label="Number 11">
      11
    </div>
    <div class="identity">
      <span class="eyebrow">ST. LOUIS KNIGHTS · 2026–27</span>
      <h1>Daniel Hammond</h1>
      <p>
        Defense <span>·</span> Shoots left <span>·</span> 13U AA
      </p>
    </div>
    <img src="/knights-logo.png" alt="St. Louis Knights crest" width="92" height="107" />
  </header>
  <div class="coverage">
    <span>{games.length} imported games</span>
    <span>Updated {dateLabel(importedOn)}</span>
    <a href={data.sourceUrl} target="_blank" rel="noreferrer">
      View in Hudl ↗
    </a>
  </div>
  <section aria-label="Totals for imported games" class="summary-grid">
    {summary.map(([label, value]) => (
      <div class="summary-stat">
        <strong>{displayStat(value)}</strong>
        <span>{label}</span>
      </div>
    ))}
  </section>
  <p class="scope">
    Stats cover the games imported below, which may not include every Knights game. Updates are added from
    Hudl exports.
  </p>
  <div class="profile-body">
    <section aria-labelledby="games-heading">
      <div class="section-heading">
        <span class="eyebrow">GAME BY GAME</span>
        <h2 id="games-heading">The season so far.</h2>
      </div>
      {games.map((game) => (
        <article class="panel player-game">
          <div class="game-heading">
            <div>
              <p class="player-game-date">
                {dateLabel(game.date)} · {game.venue === 'away' ? 'Away' : 'Home'}
              </p>
              <h3>{game.opponent}</h3>
            </div>
            <div class="score">
              <span class:list={['result', { win: game.goalsFor > game.goalsAgainst }]}>
                {game.goalsFor > game.goalsAgainst ? 'W' : game.goalsFor < game.goalsAgainst ? 'L' : 'T'}
              </span>
              <strong>
                {game.goalsFor}–{game.goalsAgainst}
              </strong>
              <small>Knights score first</small>
            </div>
          </div>
          <dl class="game-metrics">
            {['Time on ice', 'All shifts', 'Goals', 'Assists', 'Shots on goal', '+/-'].map((label) => (
              <div>
                <dt>{label === 'All shifts' ? 'Shifts' : label}</dt>
                <dd>
                  {label === '+/-'
                    ? signed(game.stats[label] as number | null)
                    : displayStat(game.stats[label])}
                </dd>
              </div>
            ))}
          </dl>
          <details>
            <summary>
              All game statistics <span aria-hidden="true">+</span>
            </summary>
            <dl class="full-stats">
              {statLabels.map((label) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{displayStat(game.stats[label])}</dd>
                </div>
              ))}
            </dl>
            <p class="source-note">
              Source: Hudl Instat · Export dated {dateLabel(game.source.asOf)}. A dash means no value was
              supplied.
            </p>
          </details>
        </article>
      ))}
    </section>
    <aside>
      <section class="panel season-notes">
        <span class="eyebrow">SHOT TOTALS</span>
        <h2>Getting pucks on net.</h2>
        <div class="shot-total">
          <strong>{displayStat(onGoal)}</strong>
          <span>on goal / {displayStat(shots)} shots</span>
        </div>
        <div class="shot-track" role="img" aria-label={`${shotRate} of shots on goal`}>
          <span style={`width:${shots && onGoal !== null ? (onGoal / shots) * 100 : 0}%`}></span>
        </div>
        <p>{shotRate} of shots on goal across imported games.</p>
        <dl class="aside-stats">
          <div>
            <dt>Hits</dt>
            <dd>{displayStat(total(games, 'Hits'))}</dd>
          </div>
          <div>
            <dt>Shifts</dt>
            <dd>{displayStat(total(games, 'All shifts'))}</dd>
          </div>
        </dl>
      </section>
      <section class="panel season-notes">
        <span class="eyebrow">VIDEO & SHIFTS</span>
        <h2>Watch in Hudl.</h2>
        <p>
          Open Daniel’s Hudl profile and choose a game’s shifts or highlights. Hudl sign-in and access are
          required.
        </p>
        <a href="https://app.hudl.com/instat/hockey/players/2473445" target="_blank" rel="noreferrer">
          Open player profile ↗
        </a>
      </section>
      <section class="data-note">
        <h2>About these stats</h2>
        <p>
          Game rows come from Hudl’s Box score export. Totals and ice-time averages are calculated from those
          rows. Stat names follow Hudl’s labels; “Blocked shots” is kept separate from “Shots blocking.”
        </p>
      </section>
    </aside>
  </div>
</Layout>
<style>
  .back {
    display: inline-block;
    margin-bottom: 20px;
    font-size: 13px;
  }
  .profile-hero {
    background: var(--ink);
    color: #fff;
    display: flex;
    align-items: center;
    gap: 26px;
    padding: 36px;
    border-radius: 10px;
    border-top: 4px solid var(--red);
  }
  .jersey {
    font-size: 96px;
    font-weight: 850;
    letter-spacing: -7px;
    line-height: 1;
    color: #fff;
    border-right: 1px solid #45474d;
    padding-right: 30px;
  }
  .identity {
    flex: 1;
  }
  .identity .eyebrow {
    color: #f0929e;
  }
  .identity p {
    color: #d4d5d8;
    margin: 0;
  }
  .identity p span {
    margin: 0 8px;
    color: #92969d;
  }
  .profile-hero img {
    object-fit: contain;
  }
  .coverage {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    font-size: 12px;
    color: var(--muted);
    padding: 18px 0;
  }
  .coverage a {
    margin-left: auto;
  }
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    background: white;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
  .summary-stat {
    padding: 23px 12px;
    text-align: center;
    border-right: 1px solid var(--line);
  }
  .summary-stat:last-child {
    border: 0;
  }
  .summary-stat strong {
    display: block;
    font-size: 30px;
    letter-spacing: -1px;
  }
  .summary-stat span {
    display: block;
    font-size: 12px;
    color: var(--muted);
    margin-top: 8px;
  }
  .scope {
    font-size: 12px;
    margin: 12px 0 32px;
  }
  .profile-body {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(240px, 1fr);
    gap: 28px;
  }
  .section-heading {
    margin-bottom: 20px;
  }
  .section-heading .eyebrow {
    margin-bottom: 8px;
  }
  .player-game {
    margin-bottom: 18px;
    padding: 24px;
  }
  .game-heading {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
  }
  .player-game-date {
    font-size: 12px;
    margin-bottom: 8px;
  }
  .game-heading h3 {
    font-size: 20px;
    margin: 0;
  }
  .score {
    text-align: right;
    flex-shrink: 0;
  }
  .score strong {
    font-size: 28px;
  }
  .score small {
    display: block;
    font-size: 10px;
    color: var(--muted);
    margin-top: 5px;
  }
  .result {
    display: inline-block;
    font-size: 11px;
    background: #f5eeee;
    color: #87242d;
    padding: 4px 6px;
    border-radius: 4px;
    margin-right: 8px;
    vertical-align: middle;
  }
  .result.win {
    background: #eaf3ed;
    color: #285f3b;
  }
  .game-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px 10px;
    background: #f7f7f6;
    padding: 18px;
    border-radius: 6px;
    margin: 22px 0 14px;
  }
  .game-metrics dt {
    font-size: 11px;
    color: var(--muted);
  }
  .game-metrics dd {
    margin: 7px 0 0;
    font-size: 23px;
    font-weight: 750;
  }
  summary {
    display: flex;
    justify-content: space-between;
    padding: 14px 0;
    font-size: 13px;
    font-weight: 650;
    list-style: none;
  }
  details {
    border-top: 1px solid var(--line);
  }
  details[open] summary span {
    transform: rotate(45deg);
  }
  .full-stats {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 24px;
  }
  .full-stats div,
  .aside-stats div {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    border-bottom: 1px solid var(--line);
    padding: 10px 0;
    font-size: 12px;
  }
  .full-stats dt,
  .aside-stats dt {
    color: var(--muted);
  }
  .full-stats dd,
  .aside-stats dd {
    margin: 0;
    font-weight: 650;
  }
  .source-note {
    font-size: 11px;
    margin: 16px 0 0;
  }
  .season-notes {
    padding: 24px;
    margin-bottom: 20px;
  }
  .season-notes h2 {
    font-size: 21px;
  }
  .season-notes p {
    font-size: 13px;
    margin: 16px 0;
  }
  .season-notes a {
    font-size: 13px;
    font-weight: 650;
  }
  .shot-total {
    margin: 24px 0 14px;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .shot-total strong {
    font-size: 48px;
    line-height: 1;
    letter-spacing: -2px;
  }
  .shot-total span {
    font-size: 12px;
    color: var(--muted);
  }
  .shot-track {
    height: 8px;
    border-radius: 4px;
    overflow: hidden;
    background: #eee;
  }
  .shot-track span {
    display: block;
    background: var(--red);
    height: 100%;
  }
  .aside-stats {
    margin: 0;
  }
  .data-note {
    padding: 4px 8px;
  }
  .data-note h2 {
    font-size: 15px;
  }
  .data-note p {
    font-size: 12px;
    margin-top: 12px;
  }
  @media (max-width: 800px) {
    .profile-body {
      grid-template-columns: 1fr;
    }
    .profile-hero {
      padding: 24px;
      gap: 18px;
    }
    .jersey {
      font-size: 70px;
      padding-right: 22px;
    }
    .profile-hero img {
      width: 60px;
      height: auto;
    }
    .summary-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .summary-stat:nth-child(-n + 3) {
      border-bottom: 1px solid var(--line);
    }
    .summary-stat:nth-child(3) {
      border-right: 0;
    }
    .summary-stat {
      padding: 18px 10px;
    }
  }
  @media (max-width: 480px) {
    .profile-hero {
      padding: 22px 18px;
    }
    .jersey {
      font-size: 52px;
      letter-spacing: -3px;
      padding-right: 16px;
    }
    .identity h1 {
      font-size: 28px;
      letter-spacing: -0.8px;
    }
    .identity .eyebrow {
      font-size: 9px;
      line-height: 1.6;
    }
    .identity p {
      font-size: 12px;
    }
    .identity p span {
      margin: 0 3px;
    }
    .profile-hero img {
      display: none;
    }
    .coverage {
      gap: 10px 16px;
    }
    .coverage a {
      margin-left: 0;
    }
    .player-game {
      padding: 18px;
    }
    .game-heading h3 {
      font-size: 17px;
    }
    .score strong {
      font-size: 24px;
    }
    .full-stats {
      grid-template-columns: 1fr;
    }
    .game-metrics {
      padding: 14px;
    }
    .summary-stat strong {
      font-size: 27px;
    }
  }
</style>
