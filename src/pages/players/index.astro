---
import Layout from '../../layouts/Layout.astro';
import raw from '../../../data/players/daniel-hammond.json';
import { playerStatsSchema } from '../../lib/player-stats';
const data = playerStatsSchema.parse(raw);
---

<Layout title="Knights players" description="St. Louis Knights player profiles and game-by-game statistics.">
  <div class="page-heading">
    <div>
      <span class="eyebrow">2013 ST. LOUIS KNIGHTS</span>
      <h1>Player profiles.</h1>
      <p>Individual game stats and season progress.</p>
    </div>
    <span class="season-chip">2026–27</span>
  </div>
  <article class="panel player-card">
    <span class="number" aria-label="Number 11">
      11
    </span>
    <div>
      <span class="eyebrow">DEFENSE · SHOOTS LEFT</span>
      <h2>
        <a href="/players/daniel-hammond/">Daniel Hammond</a>
      </h2>
      <p>{data.games.length} imported games · Hudl Instat</p>
      <a href="/players/daniel-hammond/">View profile & game stats →</a>
    </div>
  </article>
  <p class="coverage">
    Starting with Daniel’s profile. This is not a complete team roster or a team-wide statistics comparison.
  </p>
</Layout>
<style>
  .player-card {
    display: flex;
    gap: 24px;
    padding: 28px;
    max-width: 650px;
    align-items: center;
  }
  .number {
    font-size: 64px;
    font-weight: 850;
    color: var(--red);
    letter-spacing: -4px;
  }
  .player-card p {
    margin: 10px 0;
  }
  .coverage {
    margin-top: 24px;
    max-width: 650px;
    font-size: 14px;
  }
  @media (max-width: 480px) {
    .player-card {
      padding: 20px;
      gap: 18px;
    }
    .number {
      font-size: 48px;
    }
  }
</style>
