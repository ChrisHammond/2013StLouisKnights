---
import Layout from '../layouts/Layout.astro';

const eventUrl = 'https://my.200x85.com/events/53e87131-b326-4c73-a4e9-e0a17d7a40a2';
const organizerUrl = 'https://200x85.com/ccm-florida-winter-cup/';
---

<Layout
  title="Tournament · CCM Florida Winter Cup"
  description="Follow the 2013 St. Louis Knights at the CCM Florida Winter Cup in Clearwater, December 11–13, 2026."
>
  <div class="page-heading">
    <div>
      <span class="eyebrow">TOURNAMENT CENTRAL · DECEMBER 11–13, 2026</span>
      <h1>CCM Florida Winter Cup</h1>
      <p>Clearwater, Florida · 2013 age group</p>
    </div>
    <span class="season-chip">UPCOMING</span>
  </div>

  <section class="knights-banner" aria-label="Tournament overview">
    <div class="banner-identity">
      <img src="/knights-logo.png" width="100" height="116" alt="St. Louis Knights crest" />
      <div>
        <span class="eyebrow">ST. LOUIS KNIGHTS</span>
        <h2>Next stop: Clearwater</h2>
        <p>Friday, December 11 through Sunday, December 13.</p>
        <a href={eventUrl}>Official Clearwater event ↗</a>
      </div>
    </div>
  </section>

  <section class="panel tournament-panel" aria-labelledby="florida-schedule">
    <span class="eyebrow">GAMES &amp; RINKS</span>
    <h2 id="florida-schedule">Knights schedule</h2>
    <p>
      Game times, opponents, and rink assignments are pending the official schedule. Times will be listed in
      Eastern time.
    </p>
    <a href={organizerUrl}>Tournament details from 200x85 ↗</a>
  </section>

  <section class="panel tournament-panel" id="bracket" aria-labelledby="past-tournaments">
    <span class="eyebrow">PAST TOURNAMENT · NOVEMBER 6–8, 2026</span>
    <h2 id="past-tournaments">CCM World Invite Chicago</h2>
    <p>Revisit the Knights’ game results, photos, and the completed 2013 Ribcor championship bracket.</p>
    <a href="/tournament/chicago/">Open the Chicago tournament page →</a>
    <p>
      <a href="/tournament/chicago/#bracket">Jump to the Chicago bracket →</a>
    </p>
  </section>
</Layout>

<style>
  .tournament-panel {
    padding: 1.5rem;
    margin-block: 1.5rem;
  }
</style>
