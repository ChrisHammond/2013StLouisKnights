---
import Layout from '../layouts/Layout.astro';
import { videos, videoUrl } from '../lib/videos';
import { formatDate } from '../lib/history';
const replays = [...videos.videos].sort((a, b) => b.date.localeCompare(a.date));
---

<Layout title="Game videos" description="Watch St. Louis Knights game replays from Heinen Sports Network.">
  <div class="page-heading">
    <div>
      <span class="eyebrow">HEINEN SPORTS NETWORK</span>
      <h1>Watch the games.</h1>
      <p>Individual Knights broadcasts and replays on YouTube.</p>
    </div>
  </div>
  <p class="directory-note">
    <a href="https://youtube.com/@heinensportsnetwork">Visit the channel for new broadcasts ↗</a>
  </p>
  <div class="photo-grid">
    {replays.map((video) => (
      <article class="panel photo-gallery">
        <time datetime={video.date}>{formatDate(video.date)}</time>
        <h2>{video.title}</h2>
        <p>{video.gameId ? 'CSDHL regular season' : 'Preseason game'}</p>
        <a href={videoUrl(video.videoId)}>Watch on YouTube ↗</a>
      </article>
    ))}
  </div>
  <p class="schedule-source">
    Links verified {formatDate(videos.verifiedAt)}. Videos hosted by Heinen Sports Network on YouTube. New
    game links are added after verification.
  </p>
</Layout>
