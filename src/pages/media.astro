---
import Layout from '../layouts/Layout.astro';
import { photos } from '../lib/photos';
import { videos, videoUrl } from '../lib/videos';
import { formatDate } from '../lib/history';
type MediaGame = {
  title: string;
  date: string;
  gameId: string | null;
  photos: typeof photos.galleries;
  videos: typeof videos.videos;
};
const groups = new Map<string, MediaGame>();
// Preseason titles match exactly after removing the part/practice-game suffix.
// Date alone must never merge different opponents in a doubleheader.
for (const item of [...photos.galleries, ...videos.videos]) {
  const title = item.title.split(' · ')[0];
  const key = item.gameId ?? `${item.date}:${title}`;
  const group = groups.get(key) ?? { title, date: item.date, gameId: item.gameId, photos: [], videos: [] };
  if ('videoId' in item) group.videos.push(item);
  else group.photos.push(item);
  groups.set(key, group);
}
const mediaGames = [...groups.values()].sort((a, b) => b.date.localeCompare(a.date));
---

<Layout
  title="Photos & videos"
  description="Knights game photo galleries and video replays, together by game."
>
  <div class="page-heading">
    <div>
      <span class="eyebrow">2013 ST. LOUIS KNIGHTS</span>
      <h1>Photos & videos.</h1>
      <p>Game galleries from RainbowMarks Photography and replays from Heinen Sports Network.</p>
    </div>
  </div>
  <div class="panel photo-feature">
    <div>
      <h2>Follow every moment.</h2>
      <p>Check the source collections for newly published photos and broadcasts.</p>
    </div>
    <div class="photo-actions">
      <a href={photos.collectionUrl}>RainbowMarks photos ↗</a>
      <a href="https://youtube.com/@heinensportsnetwork">Heinen Sports Network on YouTube ↗</a>
    </div>
  </div>
  <div class="photo-grid">
    {mediaGames.map((game) => (
      <article class="panel photo-gallery">
        <time datetime={game.date}>{formatDate(game.date)}</time>
        <h2>{game.title}</h2>
        <p>{game.gameId ? 'CSDHL regular season' : 'Preseason game'}</p>
        {game.photos.map((photo) => (
          <p>
            <a href={photo.url}>Photos · RainbowMarks ↗</a>
          </p>
        ))}
        {game.videos.map((video) => (
          <p>
            <a href={videoUrl(video.videoId)}>
              {game.videos.length > 1
                ? `Video · ${video.title.split(' · ')[1]}`
                : 'Video · Heinen Sports Network'}{' '}
              ↗
            </a>
          </p>
        ))}
      </article>
    ))}
  </div>
  <p class="schedule-source">
    Photo links verified {formatDate(photos.verifiedAt)}; video links verified {formatDate(videos.verifiedAt)}
    . New links are added after verification.
  </p>
</Layout>
