---
import type { Team } from '../lib/schema';
import logos from '../../data/team-logos.json';
interface Props {
  team: Team;
  large?: boolean;
}
const { team, large = false } = Astro.props;
const logo = logos.find((logo) => logo.teamId === team.id);
---

<span class:list={['team-mark', { large, 'has-logo': !!logo }]} aria-hidden="true">
  {logo ? (
    <img src={logo.path} width={logo.width} height={logo.height} alt="" loading="lazy" decoding="async" />
  ) : (
    team.abbr
  )}
</span>
