---
import { photos } from '../lib/photos';
---

<section class="panel photo-feature" aria-labelledby="photo-feature-title">
  <div>
    <span class="eyebrow">RAINBOWMARKS PHOTOGRAPHY</span>
    <h2 id="photo-feature-title">The season in photos.</h2>
    <p>Find the Knights on the ice, one game at a time.</p>
  </div>
  <div class="photo-actions">
    <a class="button" href={photos.collectionUrl}>
      Browse Knights photos ↗
    </a>
    <a href="/photos/">Game galleries →</a>
  </div>
</section>
