---
import { teamMap } from '../lib/data';
import TeamMark from './TeamMark.astro';
import { gameGalleries } from '../lib/photos';
import { results } from '../lib/results';
import { formatTimestamp } from '../lib/history';
import { gameDate, gameTime, type Game } from '../lib/schedule';
interface Props {
  game: Game;
  teamId?: string;
  hidden?: boolean;
}
const { game, teamId, hidden = false } = Astro.props;
const home = teamMap.get(game.homeTeamId)!;
const away = teamMap.get(game.awayTeamId)!;
const galleries = gameGalleries(game);
const result = results.get(game.id);
const resultLabel = result?.status === 'final' ? 'Final' : 'In progress at last check';
const isKnights = home.id === 'st-louis-knights' || away.id === 'st-louis-knights';
const month = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' }).format(
  new Date(`${game.date}T12:00:00Z`),
);
---

<article
  class:list={['game-card', { 'knights-game': isKnights }]}
  hidden={hidden}
  data-game
  data-id={game.id}
  data-start={game.startsAt ?? ''}
  data-date={game.date}
  data-status={result?.status ?? game.status}
  data-venue-side={teamId ? (game.homeTeamId === teamId ? 'home' : 'away') : ''}
>
  <div class="game-date" aria-label={gameDate(game)}>
    <span>{month}</span>
    <strong>{game.date.slice(-2)}</strong>
    <small>
      {new Intl.DateTimeFormat('en-US', { weekday: 'short', timeZone: 'UTC' }).format(
        new Date(`${game.date}T12:00:00Z`),
      )}
    </small>
  </div>
  <div class="game-matchup">
    <div class="game-meta">
      <span>{teamId ? (game.homeTeamId === teamId ? 'HOME' : 'AWAY') : 'LEAGUE GAME'}</span>
      <span>#{game.gameNumber}</span>
      {result ? (
        <strong>{resultLabel}</strong>
      ) : (
        game.status !== 'scheduled' && <strong>{game.status}</strong>
      )}
    </div>
    <div class="matchup-names">
      <a
        class:list={['team-with-logo', { 'our-team': away.id === 'st-louis-knights' }]}
        href={`/teams/${away.id}/`}
      >
        <TeamMark team={away} />
        <span>
          {away.name}
          {result && <strong> · {result.awayScore}</strong>}
        </span>
      </a>
      <span class="versus">at</span>
      <a
        class:list={['team-with-logo', { 'our-team': home.id === 'st-louis-knights' }]}
        href={`/teams/${home.id}/`}
      >
        <TeamMark team={home} />
        <span>
          {home.name}
          {result && <strong> · {result.homeScore}</strong>}
        </span>
      </a>
    </div>
    <p class="game-location">{game.venue}</p>
    {result && result.awayShots !== null && result.homeShots !== null && (
      <p class="game-location">
        Shots: {away.abbr} {result.awayShots} · {home.abbr} {result.homeShots}
      </p>
    )}
    {result && (
      <p class="game-location">
        GameSheet snapshot · Checked {formatTimestamp(result.observedAt)}
        {result.status === 'in-progress' && ' · Not a live feed; final pending.'}
      </p>
    )}
  </div>
  <div class="game-time">
    <strong>
      {result ? resultLabel : <time datetime={game.startsAt ?? game.date}>{gameTime(game)}</time>}
    </strong>
    <a href={result?.sourceUrl ?? `https://gamesheetstats.com/seasons/15220/games/${game.id}`}>
      {result ? 'Box score ↗' : 'Game details ↗'}
    </a>
    {galleries.map((gallery) => (
      <a class="game-photo-link" href={gallery.url}>
        Photos · RainbowMarks ↗
      </a>
    ))}
  </div>
</article>
